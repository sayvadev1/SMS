<%@ page import="java.util.*,com.student.model.Course"  contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><!DOCTYPE html><html><head><title>Courses</title><link rel="stylesheet" href="css/style.css"></head><body><aside class="sidebar"><jsp:include page="/sidebar.jsp" /></aside><main class="main"><header class="topbar"><div><h1>Courses</h1><p>Manage academic courses</p></div></header><div class="two-col"><div class="panel form-panel"><h2>Add Course</h2><p class="muted">Create a new active course for student registration and marks.</p><%if(request.getParameter("success")!=null){%><div class="alert success">Course added successfully.</div><%}%><%if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><form method="post" action="courses"><label>Course Name *</label><input name="courseName" placeholder="e.g. Computer Networks" required><button class="btn primary full">Add Course</button></form></div><div class="panel"><div class="panel-head"><div><h2>Course Directory</h2><p>Available courses</p></div><span class="pill">${courses.size()} courses</span></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Course</th><th>Status</th></tr></thead><tbody><%for(Course c:(List<Course>)request.getAttribute("courses")){%><tr><td>#<%=c.getCourseId()%></td><td><b><%=c.getCourseName()%></b></td><td><span class="status active"><%=c.getStatus()%></span></td></tr><%}%></tbody></table></div></div></div></main></body></html>
