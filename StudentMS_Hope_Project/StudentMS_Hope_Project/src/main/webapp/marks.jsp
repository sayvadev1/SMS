<%@ page import="java.util.*,com.student.model.Student,com.student.model.Course,com.student.model.Mark"  contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><!DOCTYPE html><html><head><title>Marks</title><link rel="stylesheet" href="css/style.css"></head><body><aside class="sidebar"><jsp:include page="/sidebar.jsp" /></aside><main class="main"><header class="topbar"><div><h1>Marks</h1><p>Add or update marks for students</p></div><a class="btn secondary" href="marksheet">View Marksheet</a></header><div class="two-col"><div class="panel form-panel"><h2>Enter Marks</h2><p class="muted">One student + one course = one marks record. Saving again updates it.</p><%if(request.getParameter("success")!=null){%><div class="alert success">Marks saved successfully.</div><%}%><%if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><form method="post" action="marks"><label>Student *</label><select name="studentId" required><%for(Student s:(List<Student>)request.getAttribute("students")){%><option value="<%=s.getStudentId()%>"><%=s.getFirstName()%> <%=s.getLastName()%> (#<%=s.getStudentId()%>)</option><%}%></select><label>Course *</label><select name="courseId" required><%for(Course c:(List<Course>)request.getAttribute("courses")){%><option value="<%=c.getCourseId()%>"><%=c.getCourseName()%></option><%}%></select><div class="form-grid"><div><label>Marks *</label><input type="number" step="0.01" min="0" name="marks" required></div><div><label>Maximum Marks</label><input type="number" step="0.01" min="1" name="maxMarks" value="100" required></div></div><label>Remarks</label><textarea name="remarks" rows="3" placeholder="Optional remarks"></textarea><button class="btn primary full">Save Marks</button></form></div><div class="panel"><div class="panel-head"><div><h2>Marks Records</h2><p>Recently stored academic marks</p></div></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Course</th><th>Marks</th><th>Remarks</th></tr></thead><tbody><%for(Mark m:(List<Mark>)request.getAttribute("marks")){%><tr><td><b><%=m.getStudentName()%></b></td><td><%=m.getCourseName()%></td><td><b><%=m.getMarks()%></b> / <%=m.getMaxMarks()%></td><td><%=m.getRemarks()==null||m.getRemarks().isBlank()?"—":m.getRemarks()%></td></tr><%}%></tbody></table></div></div></div></main></body></html>
