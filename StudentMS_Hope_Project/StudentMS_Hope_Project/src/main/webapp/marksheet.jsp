<%@ page import="java.util.*,com.student.model.Student,com.student.model.Mark"  contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><!DOCTYPE html><html><head><title>Marksheet</title><link rel="stylesheet" href="css/style.css"></head><body><aside class="sidebar"><jsp:include page="/sidebar.jsp" /></aside><main class="main"><header class="topbar"><div><h1>Marksheet</h1><p>Generate a student's academic result</p></div></header><div class="panel form-panel"><form method="get" action="marksheet" class="inline-form"><div class="grow"><label>Select Student</label><select name="studentId" required><option value="">Choose a student</option><%for(Student s:(List<Student>)request.getAttribute("students")){%><option value="<%=s.getStudentId()%>" <%=request.getParameter("studentId")!=null&&request.getParameter("studentId").equals(String.valueOf(s.getStudentId()))?"selected":""%>><%=s.getFirstName()%> <%=s.getLastName()%> (#<%=s.getStudentId()%>)</option><%}%></select></div><button class="btn primary">Generate Marksheet</button></form></div><%if(request.getAttribute("selected")!=null){Student s=(Student)request.getAttribute("selected");%><div class="marksheet"><div class="marksheet-head"><div><span class="eyebrow">ACADEMIC MARKSHEET</span><h2><%=s.getFirstName()%> <%=s.getLastName()%></h2><p><%=s.getEmail()%> · <%=s.getDepartment()==null?"":s.getDepartment()%> · Student #<%=s.getStudentId()%></p></div><div class="result-badge"><b><%=request.getAttribute("result")%></b><span>Grade <%=request.getAttribute("grade")%></span></div></div><div class="table-wrap"><table><thead><tr><th>Course</th><th>Marks Obtained</th><th>Maximum</th><th>Remarks</th></tr></thead><tbody><%for(Mark m:(List<Mark>)request.getAttribute("marks")){%><tr><td><b><%=m.getCourseName()%></b></td><td><%=m.getMarks()%></td><td><%=m.getMaxMarks()%></td><td><%=m.getRemarks()==null?"—":m.getRemarks()%></td></tr><%}%></tbody></table></div><div class="result-grid"><div><span>Total</span><b><%=request.getAttribute("total")%> / <%=request.getAttribute("maxTotal")%></b></div><div><span>Percentage</span><b><%=String.format("%.2f",(Double)request.getAttribute("percentage"))%>%</b></div><div><span>Grade</span><b><%=request.getAttribute("grade")%></b></div><div><span>Result</span><b><%=request.getAttribute("result")%></b></div></div></div><%}%></main></body></html>
