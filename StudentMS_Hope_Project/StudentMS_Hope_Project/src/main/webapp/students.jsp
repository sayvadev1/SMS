<%@ page import="java.util.*,com.student.model.Student"  contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><!DOCTYPE html><html><head><title>Students</title><link rel="stylesheet" href="css/style.css"></head><body><aside class="sidebar"><jsp:include page="/sidebar.jsp" /></aside><main class="main"><header class="topbar"><div><h1>Students</h1><p>Browse registered student records</p></div><a class="btn primary" href="add-student">＋ Add Student</a></header><div class="panel"><div class="panel-head"><div><h2>Student Directory</h2><p>All registered students</p></div><span class="pill">${students.size()} records</span></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Student</th><th>Email</th><th>Department</th><th>City</th><th>Status</th></tr></thead><tbody><% for(Student s:(List<Student>)request.getAttribute("students")){ %><tr><td>#<%=s.getStudentId()%></td><td><b><%=s.getFirstName()%> <%=s.getLastName()%></b><small><%=s.getGender()==null?"":s.getGender()%></small></td><td><%=s.getEmail()%><br><small><%=s.getPhone()==null?"":s.getPhone()%></small></td><td><%=s.getDepartment()==null?"—":s.getDepartment()%></td><td><%=s.getCity()==null?"—":s.getCity()%></td><td><span class="status <%=s.getStatus().equals("ACTIVE")?"active":"inactive"%>"><%=s.getStatus()%></span></td></tr><% } %></tbody></table></div></div></main></body></html>
