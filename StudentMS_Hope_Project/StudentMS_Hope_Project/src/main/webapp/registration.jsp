<%@ page import="java.util.*,com.student.model.Course"  contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><!DOCTYPE html><html><head><title>Public Registration</title><link rel="stylesheet" href="css/style.css"></head><body class="public-page"><div class="public-top"><a href="admin-login">← Admin Login</a><span>Student Management System</span></div><div class="public-card"><div class="public-icon">🎓</div><h1>Student Registration</h1><p class="muted">Register as a student using the form below.</p><%if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><form method="post" action="register"><div class="form-grid"><div><label>First Name *</label><input name="firstName" required></div><div><label>Last Name *</label><input name="lastName" required></div><div><label>Email *</label><input type="email" name="email" required></div><div><label>Phone</label><input name="phone"></div><div><label>Gender</label><select name="gender"><option>Male</option><option>Female</option><option>Other</option></select></div><div><label>Department</label><input name="department"></div><div><label>City</label><input name="city"></div><div><label>Course *</label><select name="courseId" required><%for(Course c:(List<Course>)request.getAttribute("courses")){%><option value="<%=c.getCourseId()%>"><%=c.getCourseName()%></option><%}%></select></div></div><button class="btn primary full">Submit Registration</button></form></div></body></html>
