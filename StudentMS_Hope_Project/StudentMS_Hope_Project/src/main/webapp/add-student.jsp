<%@ page import="java.util.*,com.student.model.Course"  contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><!DOCTYPE html><html><head><title>Add Student</title><link rel="stylesheet" href="css/style.css"></head><body><aside class="sidebar"><jsp:include page="/sidebar.jsp" /></aside><main class="main"><header class="topbar"><div><h1>Add Student</h1><p>Create a new student record</p></div></header><div class="panel form-panel"><h2>Student Information</h2><p class="muted">Fill in the details below.</p><%if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><form method="post" action="add-student"><div class="form-grid"><div><label>First Name *</label><input name="firstName" required></div><div><label>Last Name *</label><input name="lastName" required></div><div><label>Email *</label><input type="email" name="email" required></div><div><label>Phone</label><input name="phone"></div><div><label>Gender</label><select name="gender"><option>Male</option><option>Female</option><option>Other</option></select></div><div><label>Department</label><input name="department"></div><div><label>City</label><input name="city"></div><div><label>Course *</label><select name="courseId" required><%for(Course c:(List<Course>)request.getAttribute("courses")){%><option value="<%=c.getCourseId()%>"><%=c.getCourseName()%></option><%}%></select></div><div><label>Status</label><select name="status"><option value="ACTIVE">ACTIVE</option><option value="INACTIVE">INACTIVE</option></select></div></div><div class="actions"><a class="btn secondary" href="students">Cancel</a><button class="btn primary">Save Student</button></div></form></div></main></body></html>
