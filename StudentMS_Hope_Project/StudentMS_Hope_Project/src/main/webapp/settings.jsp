<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html><head><title>Settings</title><link rel="stylesheet" href="css/style.css"></head><body><aside class="sidebar"><jsp:include page="/sidebar.jsp" /></aside><main class="main"><header class="topbar"><div><h1>Settings</h1><p>Manage administrator profile and account credentials</p></div></header><div class="two-col"><div class="panel form-panel"><div class="settings-title"><div class="avatar big">M</div><div><h2>Administrator Profile</h2><p class="muted">These details appear across the admin portal.</p></div></div><%if(request.getParameter("success")!=null){%><div class="alert success">Settings updated successfully.</div><%}%><%if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><form method="post" action="settings"><label>Admin Display Name *</label><input name="adminName" value="<%=request.getAttribute("adminName")%>" required><label>Username *</label><input name="username" value="<%=request.getAttribute("username")%>" required><label>New Password</label><input type="password" name="password" placeholder="Leave blank to keep current password"><label>Confirm New Password</label><input type="password" name="confirmPassword" placeholder="Repeat new password"><button class="btn primary full">Save Settings</button></form></div><div class="panel"><h2>Account & Security</h2><div class="security-item"><span class="security-icon">👤</span><div><b>Administrator Account</b><small>Controls access to the dashboard.</small></div><span class="status active">ENABLED</span></div><div class="security-item"><span class="security-icon">🔑</span><div><b>Password Protection</b><small>Change the password whenever required.</small></div></div><div class="security-item"><span class="security-icon">🌐</span><div><b>Public Registration</b><small>Available separately without admin access.</small></div></div><div class="notice"><b>Prototype note:</b> Passwords are stored plainly in this learning project. A production system should use secure password hashing, sessions with stronger controls, CSRF protection and proper authorization.</div></div></div></main></body></html>
